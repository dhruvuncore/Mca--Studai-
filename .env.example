# ==============================================================================
# StudyAI Environment Variables
# ==============================================================================

# --- AI Provider (Server-only; never expose in VITE_*) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Application Base URL ---
# Used for QStash webhook callbacks and links (e.g. https://your-app.vercel.app or http://localhost:3000)
APP_URL="http://localhost:3000"

# --- Supabase Server Configuration (Backend only) ---
# Base Project URL only (e.g. https://YOUR_PROJECT_REF.supabase.co — do NOT append /rest/v1/)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Publishable key (sb_publishable_...) or legacy anon JWT key
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# Secret key (sb_secret_...) or legacy service_role JWT key (Server-only; never expose in VITE_*)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="studyai-documents"

# Supabase PostgreSQL Connection String (Pooler or Direct; Server-only; never put in VITE_*)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# --- Supabase Frontend Configuration (Vite public env vars) ---
# Base Project HTTPS URL only (same as SUPABASE_URL; NEVER put postgresql:// here)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Publishable key (sb_publishable_...) or legacy anon JWT key (NEVER put sb_secret_ here)
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# --- Background Document Processing Queue (Upstash QStash - Free Tier, Recommended for Vercel) ---
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# --- Legacy Migration Helper (Optional; used only when running migrateJsonToSupabase.ts) ---
MIGRATION_TARGET_USER_ID=""
MIGRATION_TARGET_EMAIL=""
